# GitHub Pages 向けデモビルド（vite --mode demo）の設定。
# 認証と S3 は src/demo 配下のモジュールに差し替わるため、Cognito と S3 の値は使われない。
# resolveWebConfig が全項目を要求するので、形だけ埋めている
VITE_HOSTED_UI_BASE_URL=https://demo.invalid
VITE_OIDC_ISSUER=https://demo.invalid
VITE_WEB_APP_CLIENT_ID=demo
VITE_IDENTITY_POOL_ID=demo
VITE_USER_POOL_ID=demo
VITE_REGION=demo
VITE_PAGES_BUCKET=demo

# 公開URLの表示に使う。デモではページを配信しないので、開いても何も無い
VITE_PAGES_BASE_URL=https://okibasho.example.com

# GitHub Pages の URL。og:image の絶対 URL と、ビルドの base（サブパス）に使う
VITE_APP_BASE_URL=https://kishimotonico.github.io/okibasho-on-aws/
