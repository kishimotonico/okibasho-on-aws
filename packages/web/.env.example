# Web UI のビルド時設定（Vite の import.meta.env へ埋め込まれる）
# 対応する CDK CfnOutput は packages/infra/lib/okibasho-stack.ts を参照

# Cognito Hosted UI のベース URL (CfnOutput: HostedUiBaseUrl)
VITE_HOSTED_UI_BASE_URL=https://your-domain.auth.region.amazoncognito.com

# OIDC issuer URL (CfnOutput: OidcIssuerUrl)
# Cognito の discovery document と jwks はこちらにあり、Hosted UI のドメインには無い
VITE_OIDC_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_xxxxxxxxx

# Web 用 App Client ID (CfnOutput: WebAppClientId)
VITE_WEB_APP_CLIENT_ID=your-web-app-client-id

# Cognito Identity Pool ID (CfnOutput: IdentityPoolId)
VITE_IDENTITY_POOL_ID=ap-northeast-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cognito User Pool ID (CfnOutput: UserPoolId)
VITE_USER_POOL_ID=ap-northeast-1_xxxxxxxxx

# AWS リージョン (CfnOutput: Region)
VITE_REGION=ap-northeast-1

# pages バケット名 (CfnOutput: PagesBucketName)
VITE_PAGES_BUCKET=your-pages-bucket-name

# 公開ページのベース URL (CfnOutput: PagesBaseUrl)
VITE_PAGES_BASE_URL=https://okibasho.example.com

# 管理 UI 自身のベース URL、OGP画像などの絶対URL生成に使う (CfnOutput: AppUrl)
VITE_APP_BASE_URL=https://app.okibasho.example.com
