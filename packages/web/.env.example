# Web UI のビルド時設定（Vite の import.meta.env へ埋め込まれる）
# 対応する CDK CfnOutput は packages/infra/lib/page-share-stack.ts を参照

# Cognito Hosted UI のベース URL (CfnOutput: HostedUiBaseUrl)
VITE_HOSTED_UI_BASE_URL=https://your-domain.auth.region.amazoncognito.com

# OIDC issuer URL (CfnOutput: OidcIssuerUrl)
# Cognito の discovery document と jwks はこちらにあり、Hosted UI のドメインには無い
VITE_OIDC_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_xxxxxxxxx

# Web 用 App Client ID (CfnOutput: WebAppClientId)
VITE_WEB_APP_CLIENT_ID=your-web-app-client-id

# API のベース URL（開発用 Vite proxy の転送先。ビルド成果物には埋め込まれない）
# 本番は同一 origin の /api を使うため未設定でよい。
# 開発時に dev サーバー (localhost:3000) から実 API へ /api をプロキシするために指定する。
# 例: https://xxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/api
# VITE_API_BASE_URL=https://your-api.example.com/api
