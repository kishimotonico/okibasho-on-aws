# CDK のデプロイ設定（bin/app.ts が読み込む。シェルの環境変数が優先される）

# 社員のメールドメイン（必須）。公開 URL の /<user>/<slug>/ を pages/<user>@<EMAIL_DOMAIN>/<slug>/ に展開する
EMAIL_DOMAIN=example.jp

# デプロイ先（任意）。未設定なら AWS CLI のプロファイルから決まる
# CDK_DEPLOY_ACCOUNT=123456789012
# CDK_DEPLOY_REGION=ap-northeast-1

# 独自ドメイン（任意・3つとも指定したときだけ有効）。未設定なら CloudFront のデフォルトドメインで構築する
# ROOT_DOMAIN=example.com
# APP_DOMAIN=app.example.com
# PAGES_DOMAIN=pages.example.com
