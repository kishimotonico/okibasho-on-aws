# CDK のデプロイ設定（bin/app.ts が読み込む。シェルの環境変数が優先される）

# メンバーのメールドメイン（必須）。公開 URL の /<user>/<slug>/ を pages/<user>@<EMAIL_DOMAIN>/<slug>/ に展開する
EMAIL_DOMAIN=example.jp

# デプロイ先（任意）。未設定なら AWS CLI のプロファイルから決まる
# CDK_DEPLOY_ACCOUNT=123456789012
# CDK_DEPLOY_REGION=ap-northeast-1

# 独自ドメイン（任意）。未設定なら CloudFront のデフォルトドメインで構築し、内部ページの閲覧認証も作らない。
# pages は SERVICE_DOMAIN そのもの、app は app.<SERVICE_DOMAIN> に置く。手順は README の「独自ドメイン」
# SERVICE_DOMAIN=okibasho.example.com
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/...   # SERVICE_DOMAIN 設定時は必須。us-east-1 で手動作成

# Route 53 に Alias レコードを作る場合だけ（両方そろえる）。他サービスと共用の Hosted Zone でよい。
# 未設定なら CfnOutput の Distribution ドメインを外部 DNS に手で登録する
# HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
# HOSTED_ZONE_NAME=example.com
