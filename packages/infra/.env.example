# CDK のデプロイ設定（bin/app.ts が読み込む。シェルの環境変数が優先される）

# メンバーのメールドメイン（必須）。公開 URL の /<user>/<slug>/ を pages/<user>@<EMAIL_DOMAIN>/<slug>/ に展開する
EMAIL_DOMAIN=example.jp

# デプロイ先（任意）。未設定なら AWS CLI のプロファイルから決まる
# CDK_DEPLOY_ACCOUNT=123456789012
# CDK_DEPLOY_REGION=ap-northeast-1

# 独自ドメイン（任意・3 つそろえる）。未設定なら CloudFront のデフォルトドメインで構築し、内部ページの閲覧認証も作らない。
# pages は SERVICE_DOMAIN そのもの、app は app.<SERVICE_DOMAIN> に置く。証明書（us-east-1）と DNS 検証、
# Alias レコード、Signed Cookie の鍵ペアは CDK が作る。Hosted Zone は同じアカウントの Route 53 にあること
# SERVICE_DOMAIN=okibasho.example.com
# HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
# HOSTED_ZONE_NAME=example.com

# Google ログイン（任意）。未設定ならローカルユーザー（ID / パスワード）だけで使う。
# client secret は Secrets Manager の okibasho/google-client-secret に先に置く。手順は docs/deploy.md
# GOOGLE_CLIENT_ID=123456789012-xxxxxxxx.apps.googleusercontent.com
